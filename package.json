{
  "name": "audio-score-ai",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "prepare:transcription": "node scripts/prepare-transcription.mjs",
    "predev": "npm run prepare:transcription",
    "prebuild": "npm run prepare:transcription",
    "pretest": "npm run prepare:transcription",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "prebuild:vercel": "npm run check:firebase-runtime && npm run prepare:transcription",
    "build:vercel": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:grant": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/grant-admin.ts",
    "cleanup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx workers/cleanup-files.ts",
    "check:firebase-runtime": "node --no-experimental-require-module scripts/check-firebase-runtime.cjs"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.2.0",
    "@google-cloud/tasks": "^7.2.1",
    "@google/genai": "^2.27.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tonejs/midi": "^2.0.28",
    "@vercel/oidc": "^4.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.52.0",
    "meyda": "^5.6.3",
    "midi-writer-js": "^3.2.1",
    "music-metadata": "^12.0.0",
    "nanoid": "^6.0.2",
    "next": "^16.3.8",
    "opensheetmusicdisplay": "^2.2.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "svg-to-pdfkit": "^0.1.8",
    "tailwind-merge": "^3.7.0",
    "tone": "^15.1.22",
    "verovio": "^6.3.0",
    "vexflow": "^5.0.0",
    "wavesurfer.js": "^8.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
